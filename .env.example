NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_BRIDGE_PROGRAM_ID=EzBkC8P5wxab9kwrtV5hRdynHAfB5w3UPcPXNgMseVA8
NEXT_PUBLIC_JUPITER_API_KEY=
NEXT_PUBLIC_JUPITER_REFERRAL_ACCOUNT=
NEXT_PUBLIC_JUPITER_REFERRAL_FEE=50
NEXT_PUBLIC_ORCHESTRATOR_URL=/api

# Server-side aliases are filled from the NEXT_PUBLIC_* values by the env loader.
# You can set either name, but keep the repo-root .env as the single source.
SOLANA_HOTWALLET_SECRET=
ORCH_DB_PATH=./orchestrator.sqlite
SERVICE_FEE_BPS=0
MAYAN_API_KEY=
THORNODE_URL=https://thornode.thorchain.network
THORNODE_CLIENT_ID=wxmr
CHAINFLIP_BACKEND_URL=https://chainflip-swap.chainflip.io
EVM_HOTWALLET_PRIVATE_KEY=

# Optional search engine ownership verification (build-time metadata).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Anonymous bridge-site traffic: disabled until the deployment privacy setup
# in deploy/SEO-ANALYTICS.md has been completed. Server-only; never NEXT_PUBLIC.
WXMR_ANALYTICS_ENABLED=0
WXMR_ANALYTICS_LOGGING_DISABLED=0
WXMR_ANALYTICS_TRUST_PROXY=0
WXMR_ANALYTICS_DB_PATH=
WXMR_ANALYTICS_GEOIP_PATH=
WXMR_ANALYTICS_ADMIN_TOKEN=
# Optional extra origins, e.g. the bridge's onion HTTPS origin. Comma-separated.
WXMR_ANALYTICS_ORIGINS=
